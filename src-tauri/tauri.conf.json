{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GPT-Typeless",
  "version": "1.3.0",
  "identifier": "com.gpttypeless",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GPT-Typeless",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDQzRDNEVEMDc4Mjk0N0QKUldSOWxJSUg3Y1RFSEp5TUtTMUlCM3NaTjUzZmlNOE5XYWZqOGxSZkVTR21QREhKZ3k4c0RUS0YK",
      "endpoints": [
        "https://github.com/hkJerryLeung/GPT-Typeless/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
